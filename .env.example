# ============================================================================
# SEA Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# ============================================================================

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Inference Server (OpenAI-compatible endpoint)
# For llama.cpp, unsloth, vLLM, or other OpenAI-compatible servers.
#
# EITHER name works — `load_environment()` accepts both, because deployments use
# both. Set exactly one to avoid ambiguity about which host is in force.
OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_BASEURL=http://localhost:8000/v1
#
# HOST AND MODEL ID MUST BE CHANGED TOGETHER. The same checkpoint is commonly
# served under different ids by different runtimes, and a mismatch fails with
# `model_not_found`, not a connection error:
#
#   lemonade / llamacpp  :13305   ->  Qwen3.5-4B-GGUF
#   llama.cpp server     :8080    ->  unsloth/Qwen3.5-4B-GGUF:Q4_K_M
#
# Check what a host actually serves with:  curl -s $OPENAI_BASEURL/models
LOCAL_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0
LOCAL_API_KEY=dummy  # Most local servers don't need a real key

# DeepEval API Key (for evaluation metrics)
DEEPEVAL_API_KEY=your_deepeval_api_key_here

# Default Model Configuration
# Set to "openai_compatible" when using local inference server
DEFAULT_MODEL_PROVIDER=openai_compatible
DEFAULT_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0

# Paths
ONTOLOGY_PATH=ontology/requirements_base.yaml
DATA_DIR=data
OUTPUT_DIR=data/output

# Structured Output
# Works when the served model is tool-capable. llama.cpp is fine PROVIDED the
# model's chat template qualifies — verify before debugging anything else:
#   curl -s $OPENAI_BASEURL/props | jq .chat_template_caps.supports_tools
# If false, llama.cpp silently discards the `tools` field (no error, tool_calls
# stays null even under tool_choice="required"). SmolLM3-3B reports false;
# Qwen3.5-4B reports true.
# The code falls back to text parsing automatically when structured output fails.
USE_STRUCTURED_OUTPUT=true

# Turn cap for a structured-output attempt. Bounds the retry loop when the model
# cannot satisfy the schema. Lower = faster fallback.
MAX_STRUCTURED_TURNS=3

# Wall-clock budget for one model call, and the transport timeout under it.
# Cancellation is checked BETWEEN TURNS, so STRUCTURED_TIMEOUT_SECONDS bounds a
# retry loop; it cannot interrupt one long generation. REQUEST_TIMEOUT_SECONDS
# aborts at the HTTP layer, which is the only thing that can.
STRUCTURED_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------------
# Generation bounds — read this before blaming the prompt for a model loop
# ----------------------------------------------------------------------------
# Each agent's `temperature` and `max_tokens` are set in config/agent_config.py
# and are sent to the model on every call. They matter more than they look.
#
# A local server has its OWN defaults when the request does not override them,
# and llama.cpp's are hostile to a small model: temperature 1.0, repeat_penalty
# 1.0 (i.e. OFF), DRY off, and n_predict -1 (UNBOUNDED). Under those settings a
# 2B model can fall into a repetition loop — restating "I'm going to write the
# final answer now" until the context fills — and no turn cap can stop it,
# because a generation looping inside one turn never advances a turn.
# Confirm what a server is actually configured with:
#   curl -s $OPENAI_BASEURL/props | jq .default_generation_settings.params
#
# MODEL_EXTRA_PARAMS is a JSON object merged into every request, verbatim. Use it
# for parameters config/agent_config.py does not name — in particular the
# anti-repetition samplers, which are the real cure for a loop:
#   MODEL_EXTRA_PARAMS={"repeat_penalty": 1.1, "dry_multiplier": 0.8}
# Malformed JSON (or a non-object) fails loudly at startup rather than silently
# leaving the model unbounded.
MODEL_EXTRA_PARAMS=

# Logging
LOG_LEVEL=INFO

# ============================================================================
# Hosted model endpoints (DeepSeek, Azure Foundry, OpenAI, ...)
# ============================================================================
# Any OpenAI-compatible endpoint works by pointing OPENAI_BASE_URL at it and
# naming the model in LOCAL_MODEL_ID. Two things bite, and both are silent.
#
# 1. THE KEY. LOCAL_API_KEY is a local-server key. A hosted endpoint needs a real
#    one, and the log says which was used ("hosted endpoint" vs "local inference
#    server") because sending a live key to a local server, or a dummy to a paid
#    one, are both mistakes worth naming. DEEPSEEK_API_KEY is preferred
#    automatically when the endpoint is not localhost.
#
#    DEEPSEEK_API_KEY=
#    OPENAI_BASEURL=https://api.deepseek.com
#    LOCAL_MODEL_ID=deepseek-v4-pro
#
# 2. THINKING MODE, WHICH BREAKS STRUCTURED OUTPUT. DeepSeek enables thinking by
#    default, and in thinking mode `tool_choice: "required"` returns HTTP 400 —
#    verified against the live API: "Thinking mode does not support this
#    tool_choice". Strands sends exactly that on every structured-output call, so
#    without the setting below EVERY pass 400s and silently falls back to text
#    parsing: entities, requirement ids and quality classification are lost, and
#    patterns/scenarios come back empty. The run still reports success.
#
#    NOTE THE `extra_body` WRAPPER. The OpenAI SDK validates keyword arguments
#    against its own typed signature, so a bare `{"thinking": ...}` fails with
#    `Completions.create() got an unexpected keyword argument`. `extra_body` is
#    the SDK's supported route for provider-specific fields; it merges into the
#    request body.
#
#    MODEL_EXTRA_PARAMS={"extra_body": {"thinking": {"type": "disabled"}}}
#
# Prices are configuration rather than a table in source, so a stale number is a
# stale env file and not a lie in the code. Cost is only estimated when input and
# output prices are set; cache reads use the cache price when given, and the run
# says so when they do not.
#
#   MODEL_PRICE_INPUT_PER_MTOK=0.66
#   MODEL_PRICE_OUTPUT_PER_MTOK=1.98
#   MODEL_PRICE_CACHE_READ_PER_MTOK=0.022
#   (deepseek-v4-pro off-peak, as published 2026-09-26 — re-check before trusting
#    a figure. Off-peak is half of peak.)
#
# Transport retries. The OpenAI SDK retries 429/5xx twice by default; a long paid
# run wants more than that, since a rate limit otherwise costs a whole pass.
REQUEST_MAX_RETRIES=3

# ============================================================================
# MVP Web Application (`sea-app` / run.py)
# ============================================================================

# Where the working set and revision history live. Kept inside data/ so runtime
# state is never committed.
SEA_DATA_DIR=data/sea

# Attribution recorded against every review decision in the audit trail.
# There is no authentication yet — this is a single-reviewer MVP.
SEA_REVIEWER=architect

# Default Living System scope applied to ingested documents.
SEA_INITIATIVE=INIT-MVP-001

# Where the layered LinkML ontology lives, and the default domain pack used to
# ground extraction when the Initiative does not select one.
#
# The domain pack is the vocabulary of the SUBJECT MATTER (payment_processing,
# hr, learning_management) and is normally chosen per Initiative at /ingest.
# This is only the fallback. Leave SEA_DOMAIN_PACK EMPTY for no pack, which is a
# supported state and not a degraded one — the base ontology alone is a complete
# vocabulary for the artifact.
SEA_ONTOLOGY_DIR=ontology
SEA_DOMAIN_PACK=

# Architecture pattern catalogue the Design Assistant chooses from.
#
# The default (`ontology/catalogues/architecture_patterns.yaml`) is the shipped
# library. Point this at an organisation's own catalogue to have the agent choose
# from that instead — the file is validated against `PatternCategory`,
# `QualitySubcharacteristic` and `ArchitectureStyleName` on load, and a pattern
# outside it is still accepted but reported as unresolved for review.
SEA_PATTERN_CATALOGUE=

# Flask session key. MUST be set to a real secret in any shared deployment.
SEA_SECRET_KEY=change-me-before-anyone-else-can-reach-this

# Development server binding.
SEA_HOST=127.0.0.1
SEA_PORT=5000
SEA_DEBUG=1
