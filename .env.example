# ============================================================================
# SEA Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# ============================================================================

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Inference Server (OpenAI-compatible endpoint)
# For llama.cpp, unsloth, vLLM, or other OpenAI-compatible servers.
#
# EITHER name works — `load_environment()` accepts both, because deployments use
# both. Set exactly one to avoid ambiguity about which host is in force.
OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_BASEURL=http://localhost:8000/v1
#
# HOST AND MODEL ID MUST BE CHANGED TOGETHER. The same checkpoint is commonly
# served under different ids by different runtimes, and a mismatch fails with
# `model_not_found`, not a connection error:
#
#   lemonade / llamacpp  :13305   ->  Qwen3.5-4B-GGUF
#   llama.cpp server     :8080    ->  unsloth/Qwen3.5-4B-GGUF:Q4_K_M
#
# Check what a host actually serves with:  curl -s $OPENAI_BASEURL/models
LOCAL_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0
LOCAL_API_KEY=dummy  # Most local servers don't need a real key

# DeepEval API Key (for evaluation metrics)
DEEPEVAL_API_KEY=your_deepeval_api_key_here

# Default Model Configuration
# Set to "openai_compatible" when using local inference server
DEFAULT_MODEL_PROVIDER=openai_compatible
DEFAULT_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0

# Paths
ONTOLOGY_PATH=ontology/requirements_base.yaml
DATA_DIR=data
OUTPUT_DIR=data/output

# Structured Output
# Works when the served model is tool-capable. llama.cpp is fine PROVIDED the
# model's chat template qualifies — verify before debugging anything else:
#   curl -s $OPENAI_BASEURL/props | jq .chat_template_caps.supports_tools
# If false, llama.cpp silently discards the `tools` field (no error, tool_calls
# stays null even under tool_choice="required"). SmolLM3-3B reports false;
# Qwen3.5-4B reports true.
# The code falls back to text parsing automatically when structured output fails.
USE_STRUCTURED_OUTPUT=true

# Turn cap for a structured-output attempt. Bounds the retry loop when the model
# cannot satisfy the schema. Lower = faster fallback.
MAX_STRUCTURED_TURNS=3

# Logging
LOG_LEVEL=INFO

# ============================================================================
# MVP Web Application (`sea-app` / run.py)
# ============================================================================

# Where the working set and revision history live. Kept inside data/ so runtime
# state is never committed.
SEA_DATA_DIR=data/sea

# Attribution recorded against every review decision in the audit trail.
# There is no authentication yet — this is a single-reviewer MVP.
SEA_REVIEWER=architect

# Default Living System scope applied to ingested documents.
SEA_INITIATIVE=INIT-MVP-001

# Where the layered LinkML ontology lives, and the default domain pack used to
# ground extraction when the Initiative does not select one.
#
# The domain pack is the vocabulary of the SUBJECT MATTER (payment_processing,
# hr, learning_management) and is normally chosen per Initiative at /ingest.
# This is only the fallback. Leave SEA_DOMAIN_PACK EMPTY for no pack, which is a
# supported state and not a degraded one — the base ontology alone is a complete
# vocabulary for the artifact.
SEA_ONTOLOGY_DIR=ontology
SEA_DOMAIN_PACK=

# Architecture pattern catalogue the Design Assistant chooses from.
#
# The default (`ontology/catalogues/architecture_patterns.yaml`) is the shipped
# library. Point this at an organisation's own catalogue to have the agent choose
# from that instead — the file is validated against `PatternCategory`,
# `QualitySubcharacteristic` and `ArchitectureStyleName` on load, and a pattern
# outside it is still accepted but reported as unresolved for review.
SEA_PATTERN_CATALOGUE=

# Flask session key. MUST be set to a real secret in any shared deployment.
SEA_SECRET_KEY=change-me-before-anyone-else-can-reach-this

# Development server binding.
SEA_HOST=127.0.0.1
SEA_PORT=5000
SEA_DEBUG=1
