# ============================================================================
# SEA Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# ============================================================================

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Inference Server (OpenAI-compatible endpoint)
# For llama.cpp, unsloth, vLLM, or other OpenAI-compatible servers
OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_BASEURL=http://localhost:8000/v1  # Alternative naming (also supported)
LOCAL_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0
LOCAL_API_KEY=sk-unsloth-ce00dc61d2fce3a410f382a579a4a6c1  # Most local servers don't need real keys, use "dummy"

# DeepEval API Key (for evaluation metrics)
DEEPEVAL_API_KEY=your_deepeval_api_key_here

# Default Model Configuration
# Set to "openai_compatible" when using local inference server
DEFAULT_MODEL_PROVIDER=openai_compatible
DEFAULT_MODEL_ID=unsloth/gemma-4-E4B-it-GGUF:Q8_0

# Paths
ONTOLOGY_PATH=ontology/requirements_base.yaml
DATA_DIR=data
OUTPUT_DIR=data/output

# Structured Output
# Requires an inference server that honours forced tool_choice. llama.cpp does
# NOT — the model writes the JSON as plain text instead of calling the tool, so
# structured output always falls back and only costs latency. Set to "false" on
# llama.cpp; set to "true" for providers that support tool_choice (OpenAI,
# Anthropic, vLLM with guided decoding, etc.).
USE_STRUCTURED_OUTPUT=true

# Turn cap for a structured-output attempt. Bounds the retry loop when the model
# cannot satisfy the schema. Lower = faster fallback.
MAX_STRUCTURED_TURNS=3

# Logging
LOG_LEVEL=INFO
